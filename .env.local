# Local development environment â€” git-ignored via `.env*.local`.
# See .env.example for the full template and comments.

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=******@gmail.com
# 16-character Gmail App Password. Paste it here; it stays out of git.
SMTP_PASSWORD=************
INQUIRY_TO_EMAIL=******@gmail.com
# Optional second recipient, blind-copied. Leave empty to skip.
INQUIRY_BCC_EMAIL=******@gmail.com

# --- Public values (inlined into the browser bundle) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_WHATSAPP_NUMBER=******
NEXT_PUBLIC_PHONE_NUMBER=+*******
NEXT_PUBLIC_OFFICE_NUMBER=+******
NEXT_PUBLIC_COMPANY_EMAIL=******@gmail.com
NEXT_PUBLIC_OWNER_NAME=******
