# ---------------------------------------------------------------------------
# Jitesh Engineering Works — environment template
#
# Copy this file to `.env.local` and fill in the real values.
# `.env.local` is git-ignored (`.env*.local`); this file is tracked and must
# contain placeholders only — never a real credential.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Server-only secrets — read in Node route handlers, never sent to the browser.
# Do NOT prefix any of these with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# Gmail SMTP transport used by src/lib/mailer.js
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-account@gmail.com

# 16-character Gmail App Password (Google Account > Security > App passwords).
# Requires 2-Step Verification on the sending account.
# Place the real value in .env.local and in Vercel > Settings > Environment
# Variables only — never in this file, a commit, or a chat message.
SMTP_PASSWORD=your-16-character-app-password

# Inbox that receives inquiry notification emails
INQUIRY_TO_EMAIL=your-account@gmail.com

# Optional: second address blind-copied on every inquiry. Leave empty to skip.
INQUIRY_BCC_EMAIL=

# ---------------------------------------------------------------------------
# Public values — WARNING: every NEXT_PUBLIC_* value is inlined into the
# JavaScript bundle at build time and is readable by anyone who views source.
# Put nothing secret here; the App Password belongs in SMTP_PASSWORD above.
# ---------------------------------------------------------------------------

# Public origin used for metadataBase, canonical URLs, sitemap and robots.
# If unset or malformed, the app falls back to FALLBACK_SITE_URL in
# src/lib/siteUrl.js, which is the value shown here. Update both when a
# custom domain is attached.
NEXT_PUBLIC_SITE_URL=https://jitesh-engineering-works.vercel.app

# Business contact details rendered in the header, footer and CTAs
NEXT_PUBLIC_WHATSAPP_NUMBER=918308383673
NEXT_PUBLIC_PHONE_NUMBER=+919323397961
NEXT_PUBLIC_OFFICE_NUMBER=+919923507724
NEXT_PUBLIC_COMPANY_EMAIL=jiteshengineeringworks20@gmail.com
NEXT_PUBLIC_OWNER_NAME=Rajesh Pujari
